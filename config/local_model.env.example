# Settings for JARVIS's local language model (llama-server, loopback only).
# install.sh copies this to config/.env.local_model with a random key.
# Never commit config/.env.local_model.

# Key the voice app uses to talk to its own model server (127.0.0.1 only).
# Generate with: openssl rand -hex 24
LLAMA_SERVER_API_KEY=

# Optional: another GGUF file in models/ (default Qwen3-1.7B-Q4_K_M.gguf).
# Bigger = smarter but slower, e.g. Qwen3-4B-Instruct-2507-Q4_K_M.gguf.
# JARVIS_MODEL_FILE=

# Optional: CPU threads for the model (default: physical cores minus 2).
# PA's Performance card edits this.
# JARVIS_MODEL_THREADS=
